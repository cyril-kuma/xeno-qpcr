    authors:
      - family-names: Bustin
        given-names: Stephen A.
    title: >-
      The MIQE guidelines: minimum information for publication of
      quantitative real-time PCR experiments
    journal: Clinical Chemistry
    volume: 55
    issue: 4
    start: 611
    end: 622
    year: 2009
  - type: article
    authors:
