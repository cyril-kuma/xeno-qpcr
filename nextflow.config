manifest {
    name            = 'xeno-qpcr'
    author          = 'Stephen Atetteh'
    description     = 'Plasmodium 18S singleplex qPCR detection in blood-fed Anopheles gambiae s.l.'
    version         = '1.1.0'
    nextflowVersion = '>=25.10.0'
    mainScript      = 'main.nf'
    homePage        = 'https://github.com/stephenatetteh/xeno-qpcr'
    license         = 'MIT'
}

params {
    help              = false
    randomise         = false
    plates            = null
    sample_sheet      = null
    specimens         = null
    round1_calls      = null
    outdir            = 'results'

    // ---- sample-sheet reconciliation ----
    // Assigned specimens with no record in the specimens tab. A handful is a
    // documented gap; a large number means the two tabs describe different
    // specimens, which a silent intersection could not distinguish.
    max_unmatched_specimens = 20

    // ---- design-time allocation (--randomise) ----
    randomisation_seed = 20261001
    n_plates           = 60
    slots_per_plate    = 12
    first_round_slots  = null

    // ---- plate structure ----
    sheet             = 'Results'
    header_row        = 46
    targets           = 'Pf,Pm,Po'
    dominant_target   = 'Pf'
    // Plates whose identifier matches carry known-composition material,
    // characterise the assay, and are excluded from prevalence.
    validation_plate_pattern = '^V'

    // ---- calling rule ----
    cq_positive_max   = 38.0
    // Upper bound of the trace band for specimen wells. Distinct from
    // ctl_amplification_max below, which decides whether a control well
    // amplified; the two share a value but answer different questions.
    cq_trace_max      = 40.0
    cqconf_targets    = 'Pm'
    cqconf_min        = 0.50
    // Primary specificity rule: these targets cannot be positive in a
    // mosquito where the dominant target is positive (cross-amplification).
    codetection_exclude = 'Po'
    restrict_to_metadata = true
    // Metadata column holding the plate Sample Name, and an optional regex
    // whose group 1 is the join key (for composite identifiers such as
    // NS_003_NIH00124L). Leave the pattern null for a plain key.
    metadata_key         = 'sample_code'
    metadata_key_pattern = null

    // cross-amplification sensitivity arm (never alters the primary call)
    guardband_grid    = '0,1,2,3,5'

    // ---- internal positive control ----
    // The IPC was not incorporated during the study period (assay design
    // §10), so it is off and the report instead carries the count of
    // specimens with no signal at any target. Enabling it routes specimens
    // failing the IPC to indeterminate rather than to negative.
    ipc_enabled       = false
    ipc_target        = 'IPC'
    ipc_cq_max        = 32.0

    // ---- standard-curve acceptance (assay design §4, §9) ----
    miqe_r2_min       = 0.99
    miqe_eff_min      = 90.0
    miqe_eff_max      = 110.0
    miqe_slope_min    = -3.58
    miqe_slope_max    = -3.10

    // ---- control acceptance (assay design §5, §9) ----
    ctl_amplification_max = 40.0
    pos_ctl_cq_tolerance  = 2.0

    // ---- randomisation and plate-structure checks ----
    balance_strata    = 'bioclimatic_zone,collection_method,collection_location,year'
    icc_groups        = 'plate,collection_location,bioclimatic_zone'
    max_level_share   = 0.75
    n_perm            = 2000
    seed              = 42

    allow_ingest_drift        = false
    allow_plate_map_mismatch  = false
}

process {
    errorStrategy = 'terminate'
    cpus   = 1
    memory = 2.GB
    // Per-plate intermediates stay in work/. The validated well table, the
    // flattened audit and every table a result rests on are published.
    publishDir = [[path: { "${params.outdir}/${task.process.tokenize(':').last().toLowerCase()}" },
                   mode: 'copy']]
    withName: INGEST_PLATE { memory = 1.GB; publishDir = [[enabled: false]] }
    withName: MERGE_WELLS  { publishDir = [[enabled: false]] }
}

profiles {
    standard { process.executor = 'local' }
    conda    { conda.enabled = true;  process.conda  = "${projectDir}/environment.yml" }
    docker   { docker.enabled = true
               process.container = 'ghcr.io/stephenatetteh/xeno-qpcr:1.1.0' }
    slurm    { process.executor = 'slurm'; process.queue = 'normal' }
    // A two-plate synthetic fixture, so CI exercises the whole workflow
    // without real specimen data in the repository.
    //
    // The profile sets its own outdir, because a `--param` given on the
    // command line replaces a profile's whole params block rather than
    // merging into it. Run this profile on its own, or override it with
    // `-params-file`, not with `--param` flags.
    test {
        params {
            plates       = "${projectDir}/tests/data/plates/*.xlsx"
            sample_sheet = "${projectDir}/tests/data/sample_sheet.xlsx"
            specimens    = "${projectDir}/tests/data/sample_sheet.xlsx"
            outdir       = 'results_test'
            n_perm       = 200
        }
    }
}

report   { enabled = true; file = "${params.outdir}/pipeline_info/report.html";   overwrite = true }
timeline { enabled = true; file = "${params.outdir}/pipeline_info/timeline.html"; overwrite = true }
trace    { enabled = true; file = "${params.outdir}/pipeline_info/trace.txt";     overwrite = true }
dag      { enabled = true; file = "${params.outdir}/pipeline_info/dag.html";      overwrite = true }
